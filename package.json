{
  "name": "god-en-egg",
  "private": true,
  "version": "1.0.0",
  "description": "Goden Egg - 会生金蛋的鸡 · 本地优先的股票交易与复盘工作台",
  "author": "Goden Egg",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "start": "node server.mjs",
    "start:open": "node server.mjs --open",
    "build:server": "esbuild server.mjs --bundle --platform=node --format=cjs --outfile=packaged-server.cjs",
    "build:exe": "npm run build && npm run build:server && pkg packaged-server.cjs --config pkg.config.json --targets node22-win-x64 --output GodenEgg.exe --compress GZip"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@yao-pkg/pkg": "^6.24.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
